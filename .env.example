# Copy to .env and fill in. Never commit the real .env.

# Required — Claude API key for moment detection + metadata generation
ANTHROPIC_API_KEY=

# Optional — OAuth credentials for one-click publishing.
# Leave blank if you aren't wiring up auto-posting yet.

# YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# X / Twitter (OAuth 2.0)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=repurpose-tool/1.0
